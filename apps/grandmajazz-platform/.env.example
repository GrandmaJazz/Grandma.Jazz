# --- Runtime ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Mount path. Production target uses root "/".
# (BASE_PATH is supported technically; if changed, frontend assets, routes,
# images, links, and API calls automatically respect it.)
BASE_PATH=/

# Public site URL used for OpenGraph image absolute URLs
PUBLIC_URL=https://www.grandmajazz.com

# Separate production login/session signing secret
SESSION_SECRET=

# --- Database ---
# Postgres connection string (Neon serverless or any compatible Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Mailing list (Mailchimp) — optional ---
# If any of these are missing, Mailchimp is skipped without crashing.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# ============================ Events platform ============================
# HMAC secret for ticket links (falls back to SESSION_SECRET; set a dedicated
# value so rotating the session secret doesn't invalidate ticket links)
EVENTS_TOKEN_SECRET=

# Email delivery for events: resend | capture | disabled
# (capture stores rendered emails in the outbox without sending — dev/test)
EVENTS_EMAIL_MODE=resend
EVENTS_EMAIL_FROM="Grandma Jazz <family@mail.grandmajazz.com>"
EVENTS_OUTBOX_INTERVAL_MS=15000

# Event media uploads (absolute path recommended in production)
EVENTS_UPLOADS_DIR=./uploads/events
EVENTS_MAX_UPLOAD_BYTES=8388608

# Default IANA timezone for new events
EVENTS_DEFAULT_TIMEZONE=Asia/Bangkok

# --- Apple Wallet (disabled until real credentials exist; see
#     docs/events/CREDENTIAL_SETUP.md) ---
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=pass.store.grandmajazz.events
APPLE_TEAM_ID=
# PEM certificate from the Apple portal (converted from the downloaded .cer)
APPLE_PASS_CERT_PATH=/etc/grandmajazz/wallet/apple/pass-signing-cert.pem
# PEM private key generated with the CSR on this server (root-only, not in git)
APPLE_PASS_KEY_PATH=/etc/grandmajazz/wallet/apple/pass-signing-key.pem
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=/etc/grandmajazz/wallet/apple/wwdr-g4.pem
APPLE_WALLET_ASSET_DIR=server/events/wallet/apple-assets

# --- Google Wallet (disabled until issuer approval; see CREDENTIAL_SETUP.md) ---
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY_PATH=
GOOGLE_WALLET_ORIGIN=https://www.grandmajazz.com

# Used with: npm run events:create-admin -- <email> [name]
# EVENTS_FIRST_ADMIN_EMAIL=
